void automation.Unallocated_Apply_SLA_Universal_Tag_Clearance_Delayed1(String orecid,String otag,String expected_status,String module_name)
{
try
{
	if(orecid == null || orecid.toString().trim() == "" || otag == null || otag.toString().trim() == "" || expected_status == null || expected_status.toString().trim() == "" || module_name == null || module_name.toString().trim() == "")
	{
		info "UNALLOCATED_SLA ABORTED | Required argument missing.";
		return;
	}
	recordId = orecid.toString().trim();
	requestedTag = otag.toString().trim();
	expectedStatus = expected_status.toString().trim();
	moduleName = module_name.toString().trim();
	if(!requestedTag.equalsIgnoreCase("Delayed") && !requestedTag.equalsIgnoreCase("Critical"))
	{
		info "UNALLOCATED_SLA ABORTED | Invalid tag: " + requestedTag;
		return;
	}
	if(requestedTag.equalsIgnoreCase("Delayed")) requestedTag = "Delayed";
	else requestedTag = "Critical";
	rec = zoho.crm.getRecordById(moduleName,recordId.toLong());
	if(rec == null || rec.isEmpty())
	{
		info "UNALLOCATED_SLA ABORTED | Record not found | Module: " + moduleName + " | ID: " + recordId;
		return;
	}
	currentStatusValue = rec.get("Status");
	if(currentStatusValue == null)
	{
		info "UNALLOCATED_SLA ABORTED | Current Status is empty.";
		return;
	}
	currentStatus = currentStatusValue.toString().trim();
	if(!currentStatus.equalsIgnoreCase(expectedStatus))
	{
		info "UNALLOCATED_SLA SKIPPED | Expected: " + expectedStatus + " | Current: " + currentStatus;
		return;
	}
	existingTags = rec.get("Tag");
	if(existingTags == null) existingTags = List();
	tagAlreadyExists = false;
	for each tg in existingTags
	{
		if(tg != null)
		{
			tgName = tg.get("name");
			if(tgName != null && tgName.toString().trim().equalsIgnoreCase(requestedTag)) tagAlreadyExists = true;
		}
	}
	if(tagAlreadyExists)
	{
		info "UNALLOCATED_SLA SKIPPED | Tag already exists: " + requestedTag;
		return;
	}
	finalTags = List();
	for each existingTag in existingTags finalTags.add(existingTag);
	newTag = Map();
	newTag.put("name",requestedTag);
	finalTags.add(newTag);
	updateMap = Map();
	updateMap.put("Tag",finalTags);
	response = zoho.crm.updateRecord(moduleName,recordId.toLong(),updateMap);
	info "UNALLOCATED_SLA RESULT | Module: " + moduleName + " | ID: " + recordId + " | Status: " + currentStatus + " | Tag: " + requestedTag + " | Response: " + response;
}
catch(e)
{
	info "UNALLOCATED_SLA ERROR | ID: " + orecid + " | Line: " + e.lineNo + " | Message: " + e.message;
}
}