void automation.BOOKING_Remove_Check_Vessel_Name(String booking_id)
{
try
{
	bookingId = booking_id.toString();

	booking = zoho.crm.getRecordById("Deals",bookingId.toLong());
	currentStage = booking.get("Stage");

	if(currentStage != null && (currentStage.toString().equalsIgnoreCase("Open") || currentStage.toString().equalsIgnoreCase("Pending Shipment")))
	{
		return;
	}

	existingTags = booking.get("Tag");
	finalTags = List();

	if(existingTags == null || existingTags.isEmpty())
	{
		return;
	}

	for each existingTag in existingTags
	{
		tagName = existingTag.get("name");

		if(tagName == null || !tagName.toString().equalsIgnoreCase("Check Vessel Name"))
		{
			finalTags.add(existingTag);
		}
	}

	updateMap = Map();
	updateMap.put("Tag",finalTags);
	zoho.crm.updateRecord("Deals",bookingId.toLong(),updateMap);
}
catch(e)
{
	info "BOOKING_REMOVE_CHECK_VESSEL_NAME ERROR | Booking: " + booking_id + " | Error: " + e;
}
}